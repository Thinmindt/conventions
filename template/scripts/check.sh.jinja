#!/bin/bash
# The gates every commit must pass, in the order that fails fastest. CI runs this same script.
# Generated from the conventions template: change the template or .copier-answers.yml, not this.
set -euo pipefail
cd "$(dirname "$0")/.."

files() { git ls-files -z --cached --others --exclude-standard "$@"; }

bash scripts/check_private.sh
{%- if "python" in languages %}
uvx ruff==0.15.8 check .
uvx ruff==0.15.8 format --check .
{%- if type_checker == "ty" %}
uv run ty check .
{%- elif type_checker == "pyright" %}
uv run pyright
{%- elif type_checker == "mypy" %}
uv run mypy .
{%- endif %}
{%- endif %}
if [ -n "$(files '*.sh' | tr -d '\0')" ]; then
    files '*.sh' | xargs -0 uvx --from shellcheck-py==0.11.0.1 shellcheck
fi
files | xargs -0 uvx codespell==2.4.3
{%- if "python" in languages %}
if [ -d tests ]; then
    uv run pytest -q
fi
{%- endif %}
echo "all checks passed"
